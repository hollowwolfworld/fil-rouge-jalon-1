@model InscriptionViewModel

@{
    ViewData["Title"] = "Inscription";
}
@if (ViewData.ContainsKey("ValidateMessage"))
{
    <p>@ViewData["ValidateMessage"]</p>
}
@if (TempData.ContainsKey("ValidateMessage"))
{
    <p>@TempData["ValidateMessage"]</p>
}
<h2>Inscription</h2>

<form asp-action="Inscription" asp-controller="Acces" method="post">
   <div>

    <div class="form-group">
        <label asp-for="@Model.Nom"></label>
        <input asp-for="@Model.Nom" class="form-control" />
        <span asp-validation-for="@Model.Nom" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="@Model.Prenom"></label>
        <input asp-for="@Model.Prenom" class="form-control" />
        <span asp-validation-for="@Model.Prenom" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="@Model.Email"></label>
        <input asp-for="@Model.Email" class="form-control" />
        <span asp-validation-for="@Model.Email" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="@Model.MotDePasse"></label>
        <input asp-for="@Model.MotDePasse" class="form-control" type="password" />
        <span asp-validation-for="@Model.MotDePasse" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="@Model.ConfirmMotDePasse"></label>
        <input asp-for="@Model.ConfirmMotDePasse" class="form-control" type="password" />
        <span asp-validation-for="@Model.ConfirmMotDePasse" class="text-danger"></span>
    </div>
   </div>
   <div>
        <div class="form-group">
            <label asp-for="@Model.Adresse!.Street_number"></label>
            <input asp-for="@Model.Adresse!.Street_number" class="form-control" />
            <span asp-validation-for="@Model.Adresse!.Street_number" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="@Model.Adresse!.Street_name"></label>
            <input asp-for="@Model.Adresse!.Street_name" class="form-control" />
            <span asp-validation-for="@Model.Adresse!.Street_name" class="form-control"></span>
        </div>
        <div class="form-group">
            <label asp-for="@Model.Adresse!.City"></label>
            <input asp-for="@Model.Adresse!.City" class="form-control" />
            <span asp-validation-for="@Model.Adresse!.City" class="form-control"></span>
        </div>
        <div class="form-group">
            <label asp-for="@Model.Adresse!.Postcode"></label>
            <input asp-for="@Model.Adresse!.Postcode" class="form-control" />
            <span asp-validation-for="@Model.Adresse!.Postcode" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="@Model.Adresse!.Country"></label>
            <input asp-for="@Model.Adresse!.Country" class="form-control" />
            <span asp-validation-for="@Model.Adresse!.Country" class="text-danger"></span>
        </div>
   </div>
    <button type="submit" class="btn btn-primary">S'inscrire</button>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}