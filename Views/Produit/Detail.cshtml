@model Produit

@{
    ViewData["Title"] = "fiche produit";
}
<main class="fiche_prod">


<h1>fiche produit</h1>

<div id="cadre">

<div class="carouselle">
    <ul class="clc">
    @foreach (var image in Model.imagesProduits)
    {
    @if (image == Model.imagesProduits[0])
            {
                <li class="slide active">
                    <img class="imgcarou" src="@image.url" alt="image carouselle" />
                </li>
            };
            @if (image != Model.imagesProduits[0])
            {
                <li class="slide">
                    <img class="imgcarou" src="@image.url" alt="image carouselle" />
                </li>
            }
    }
    </ul>
    <div class="prevnext">
    <button class="btnCarouselle" id="prev">&#10096</button>
    <button class="btnCarouselle" id="next">&#10097</button>
    </div>

        </div>
</div>

    <nav id="elem_FicheProd">


<article id="descFicheProd">

    <p>@Model.description</p>

</article>

        <article id="sellerFicheProd">

    <p>vendeur: @Model.seller</p>

</article>

        <article id="priceFicheProd">

    <p>prix: @Model.price</p>

</article>

        <article id="quantityFicheProd">

     <p>il reste en stock @Model.quantity unité de ce produit</p>

</article>
        @if (User.IsInRole("User"))
        {
            <button id="ajoutPanier">
                <a asp-area="" asp-controller="Panier" asp-action="AddProduct" asp-route-id="@(Model.product_id)">ajouter au panier</a>
            </button>

        }
        @if (User.IsInRole("Admin"))
        {
            <button id="modifierprod">
                <a asp-area="" asp-controller="Produit" asp-action="Modification" asp-route-id="@(Model.product_id)">modifier produit</a>
            </button>

        }
      
</nav>

</main>