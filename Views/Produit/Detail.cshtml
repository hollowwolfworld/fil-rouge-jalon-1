@model Produit

@{
    ViewData["Title"] = "fiche produit";
}
<main class="fiche_prod">


<h1>fiche produit</h1>


<div class="carouselle">
    <ul class="clc">
    @foreach (var image in Model.imagesProduits)
    {
    @if (image == Model.imagesProduits[0])
            {
                <li class="slide active">
                    <img class="imgcarou" src="@image.url" alt="image carouselle" />
                </li>
            };
            @if (image != Model.imagesProduits[0])
            {
                <li class="slide">
                    <img class="imgcarou" src="@image.url" alt="image carouselle" />
                </li>
            }
    }
    </ul>
    <div class="prevnext">
    <button class="btnCarouselle" id="prev">&#10096</button>
    <button class="btnCarouselle" id="next">&#10097</button>
    </div>
</div>

    <nav id="elem_FicheProd">


<article id="descFicheProd">

    <p>@Model.description</p>

</article>

        <article id="sellerFicheProd">

    <p>@Model.seller</p>

</article>

        <article id="priceFicheProd">

    <p>@Model.price</p>

</article>

        <article id="quantityFicheProd">

     <p>@Model.quantity</p>

</article>
        @if (User.Identity.IsAuthenticated)
        {
            <button id="ajoutPanier">
                <a asp-area="" asp-controller="Panier" asp-action="Detail">ajouter au panier</a>
            </button>

        }
      
</nav>

</main>