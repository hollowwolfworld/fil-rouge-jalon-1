@model EditionViewModel


<h1>edition</h1>

<form asp-controller="Produit" asp-action="CreeProd" method="post">

    <table>

        <tr>
            <td><label asp-for="@Model.Produit.name"></label></td>
            <td><input asp-for="@Model.Produit.name"></td>
            <td><span asp-validation-for="@Model.Produit.name" class="text-danger"></span></td>
        </tr>
        <tr>
            <td><label asp-for="@Model.Produit.seller"></label></td>
            <td><input asp-for="@Model.Produit.seller"></td>
            <td><span asp-validation-for="@Model.Produit.seller" class="text-danger"></span></td>
        </tr>
        <tr>
            <td><label asp-for="@Model.Produit.short_desc"></label></td>
            <td><input asp-for="@Model.Produit.short_desc"></td>
            <td><span asp-validation-for="@Model.Produit.short_desc" class="text-danger"></span></td>
        </tr>
        <tr>
            <td><label asp-for="@Model.Produit.description"></label></td>
            <td><input asp-for="@Model.Produit.description"></td>
            <td><span asp-validation-for="@Model.Produit.description" class="text-danger"></span></td>
        </tr>
        <tr>
            <td><label asp-for="@Model.Produit.name"></label></td>
            <td><input asp-for="@Model.Produit.name"></td>
            <td><span asp-validation-for="@Model.Produit.name" class="text-danger"></span></td>
        </tr>
        <tr>
            <td><label asp-for="@Model.Produit.discount"></label></td>
            <td><input asp-for="@Model.Produit.discount"></td>
            <td><span asp-validation-for="@Model.Produit.discount" class="text-danger"></span></td>
        </tr>
        <tr>
            <td><label asp-for="@Model.Produit.price"></label></td>
            <td><input asp-for="@Model.Produit.price"></td>
            <td><span asp-validation-for="@Model.Produit.price" class="text-danger"></span></td>
        </tr>
        <tr>
            <td><label asp-for="@Model.Produit.quantity"></label></td>
            <td><input asp-for="@Model.Produit.quantity"></td>
            <td><span asp-validation-for="@Model.Produit.quantity" class="text-danger"></span></td>
        </tr>
        <tr>
            <select asp-for="@Model.Produit.categoriesProd" asp-items="Model.Categories"></select>
        </tr>
    </table>








</form>