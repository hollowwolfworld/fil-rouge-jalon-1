@model List<Produit>

@{
    ViewData["Title"] = "page d'acceuil";
}

<nav id="acceuil">
    <h1>acceuil</h1>

<article class="Card">
    <div>
       @foreach (var item in Model)
        {
            <p>@item.name</p>

            @foreach (var images in item.imagesProduits)
            {
                <img id="imgCard" src="@images.url" />
            }

            <p>@item.price</p>
            <p>@item.short_desc</p>
            <button>lala</button>
         }
    </div>
</article>

</nav>



