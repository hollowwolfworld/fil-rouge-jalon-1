@model List<Produit>

@{
    ViewData["Title"] = "page d'acceuil";
}

<h1>acceuil</h1>

<nav id="acceuil">
    


       @foreach (var item in Model)
        {
    <article class="Card">
            <p>@item.name</p>

            @foreach (var images in item.imagesProduits)
            {
                <img id="imgCard" src="@images.url" />
            }

            <p>@item.price</p>
            <p>@item.short_desc</p>
            <button>lala</button>
    </article>
         }

</nav>



