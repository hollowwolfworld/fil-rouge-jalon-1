@model List<Produit>

@{
    ViewData["Title"] = "page d'acceuil";
}

<h1>acceuil</h1>

<nav id="acceuil">
    


       @foreach (var item in Model)
        {
    <article class="Card">
            <p>@item.name</p>

            @if (item.imagesProduits.Count > 0)
            {
                <img id="imgCard" src="@item.imagesProduits[0].url" />
            }
            @if (item.imagesProduits.Count <= 0)
            {
                <img id="imgCard" src="~/img/sansImage.jpg" />
            }
            

            <p>@item.price</p>
            <p>@item.short_desc</p>

            @foreach (var categorie in item.categoriesProd)
                {
                    <p>@categorie.name</p>
                }

            <button>
                <a asp-area="" asp-controller="Produit" asp-action="Detail" asp-route-id="@(item.product_id)">fiche produit</a>
            </button>
    </article>
         }

</nav>



