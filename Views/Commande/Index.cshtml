@model Dictionary<Produit, int>

@{
    ViewData["Title"] = "commandes";
}

<main>


    <div>
        @foreach (var item in Model)
        {
            <div id="commande">
            <div>@item.Key.name</div>
            <div> quantité commandée:   @item.Value</div>
            </div>
        }


    </div>



<script src="~/js/site.js"></script>

</main>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        DateLivraison("@ViewData["zipCode"]");
    });
</script>