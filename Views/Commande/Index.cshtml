@model Dictionary<Produit, int>

@{
    ViewData["Title"] = "commandes";
}

<main>


    <div>
        @foreach (var item in Model)
        {
            <div>@item.Key.name</div>
            <div>@item.Value</div>
        }


    </div>

    <div id="jour">coucou</div>


</main>
<script src="~/js/site.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        DateLivraison("@ViewData["zipCode"]");
    });
</script>