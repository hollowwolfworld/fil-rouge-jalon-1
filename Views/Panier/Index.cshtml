@model PanierViewModel

@{
    ViewData["Title"] = "panier";
}


<main>


<div id="centrer">
<h1>panier</h1>


    @foreach (var item in Model.cart.Produits)
    {
        <article class="Card_panier">
            <p>@item.Key.name</p>

            @if (item.Key.imagesProduits.Count > 0)
            {
                <img id="imgCard" src="@item.Key.imagesProduits[0].url" />
            }
            @if (item.Key.imagesProduits.Count <= 0)
            {
                <img id="imgCard" src="~/img/sansImage.jpg" />
            }


            <p>prix: @item.Key.price</p>
            <p>@item.Key.short_desc</p>
            <p>nombre de ce produit commander: @item.Value</p>
            <button>
                <a asp-area="" asp-controller="Panier" asp-action="DeletteProduct" asp-route-id="@(item.Key.product_id)">retirer du panier</a>
            </button>
        </article>
    }

    <div>prix total: @Model.PrixPanier</div>

    <button>
        <a asp-area="" asp-controller="Panier" asp-action="Paiment" asp-route-id="@(Model.cart.CartId)">passer au paiment</a>
    </button>
    </div>
</main>
