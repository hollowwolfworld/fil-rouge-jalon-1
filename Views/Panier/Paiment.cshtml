@model PanierViewModel

@{
    ViewData["Title"] = "Paiment";
}

@if (ViewData.ContainsKey("ValidateMessage"))
{
    <p>@ViewData["ValidateMessage"]</p>
}
@if (TempData.ContainsKey("ValidateMessage"))
{
    <p>@TempData["ValidateMessage"]</p>
}

<main>

    <h1>paiment</h1>

    <p>voici votre total payer: @Model.PrixPanier</p>

    <form asp-action="Paiment" asp-controller="Panier" method="post">

        <div class="form-group">
            <label asp-for="@Model.NumeroCarteBc"></label>
            <input asp-for="@Model.NumeroCarteBc" class="form-control" />
            <span asp-validation-for="@Model.NumeroCarteBc" class="text-danger"></span>
        </div>

       
        <button type="submit" class="btn btn-primary">payer</button>
    
        

    </form>
</main>



