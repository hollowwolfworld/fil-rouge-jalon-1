<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - e_commerce</title>
    @* <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /> *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/e_commerce.styles.css" asp-append-version="true" />
</head>
<body>
    <header id="header">
        <img id="logo" src="/img/logo.png"/>

        <partial name="_CookieConsentPartial" />
       
        @if(User.Identity.IsAuthenticated)
        {
         <div id="elemUser">

            @if (User.IsInRole("Admin"))
            {
                <p>administrateur</p>
            }
            else if (User.IsInRole("User"))
            {
                <p>utilisateur</p>
            }
            <p>@User.Identity.Name</p>
        </div>
        }

        <nav class="navbar">
            <div>
                @await Component.InvokeAsync("Navbar")
            </div>
        </nav>
           
        <div id="icons"></div>
    </header>

    <nav id="menu">
        <ul id="elem_burger">
            <li id="burger">
                <a asp-area="" asp-controller="Acceuil" asp-action="Index">acceuil</a>
            </li>
            @if (User.Identity.IsAuthenticated)
            {
                @if (User.IsInRole("User"))
                {
            <li id="burger">
                        <a asp-area="" asp-controller="Panier" asp-action="Index">panier</a>
            </li>     
                    <li id="burger">
                        <a asp-area="" asp-controller="Commande" asp-action="Index">commandes passer</a>
                    </li>
                }

                @if (User.IsInRole("Admin"))
                {
                    <li id="burger">
                        <a asp-area="" asp-controller="Produit" asp-action="Creation">cree produit</a>
                    </li>
                    <li id="burger">
                        <a asp-area="" asp-controller="User" asp-action="Index">liste utilisateur</a>
                    </li>

                }

                <li class="nav-item">
                    <a class="nav-link text-dark" asp-area="" asp-controller="Acces"
                       asp-action="Deconnexion">Déconnexion</a>
                </li>
            }
            else
            {
                <li class="nav-item">
                    <a class="nav-link text-dark" asp-area="" asp-controller="Acces"
                       asp-action="Inscription">Inscription</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-dark" asp-area="" asp-controller="Acces"
                       asp-action="Connexion">Connexion</a>
                </li>
            }
        </ul>
    </nav>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
